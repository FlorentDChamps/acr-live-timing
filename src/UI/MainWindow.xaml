<Window x:Class="ACRLiveTiming.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACR Live Timing" Height="775" Width="1200"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <!-- Themeable brushes. These light defaults let the designer render; the
         code-behind overwrites every key on startup from the light/dark palette
         (default = OS preference). All chrome below references them via
         DynamicResource so a theme switch repaints instantly. -->
    <SolidColorBrush x:Key="Brush.Window"        Color="#F5F6F8"/>
    <SolidColorBrush x:Key="Brush.Card"          Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Input"         Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.Console"       Color="#FBFCFD"/>
    <SolidColorBrush x:Key="Brush.Border"        Color="#D0D7DE"/>
    <SolidColorBrush x:Key="Brush.BorderHover"   Color="#BFC7CF"/>
    <SolidColorBrush x:Key="Brush.Text"          Color="#1F2328"/>
    <SolidColorBrush x:Key="Brush.ButtonText"    Color="#24292F"/>
    <SolidColorBrush x:Key="Brush.ButtonBg"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ButtonHover"   Color="#F3F4F6"/>
    <SolidColorBrush x:Key="Brush.ButtonPressed" Color="#E7E9EC"/>
    <SolidColorBrush x:Key="Brush.Muted"         Color="#656D76"/>
    <SolidColorBrush x:Key="Brush.Faint"         Color="#8C959F"/>
    <SolidColorBrush x:Key="Brush.Accent"        Color="#1A7F37"/>
    <SolidColorBrush x:Key="Brush.SwitchOff"     Color="#CDD3DA"/>
    <SolidColorBrush x:Key="Brush.SwitchOn"      Color="#656D76"/>
    <SolidColorBrush x:Key="Brush.SwitchThumb"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack"      Color="#ECEEF1"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb"      Color="#C4CBD3"/>
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#AEB6BF"/>

    <!-- flat themed scrollbar: thin, rounded thumb, no arrow buttons -->
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="tb" CornerRadius="5" Background="{DynamicResource Brush.ScrollThumb}"
                    MinHeight="28" MinWidth="28" Margin="2" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tb" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="tb" Property="Background" Value="{DynamicResource Brush.ScrollThumbHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- transparent page-scroll areas around the thumb (no arrow chrome) -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource Brush.ScrollTrack}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="12"/>
                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- iOS-style toggle switch built on CheckBox: pill track + sliding thumb -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                    Background="{DynamicResource Brush.SwitchOff}"
                    SnapsToDevicePixels="True">
              <Ellipse x:Name="thumb" Width="16" Height="16"
                       Fill="{DynamicResource Brush.SwitchThumb}"
                       Stroke="{DynamicResource Brush.BorderHover}" StrokeThickness="0.5"
                       HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource Brush.SwitchOn}"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="thumb" Property="Stroke" Value="{DynamicResource Brush.Muted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- flat card GroupBox: thin border, rounded, header label on top -->
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="Padding" Value="12,6,12,12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GroupBox">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Background="{DynamicResource Brush.Card}"
                    SnapsToDevicePixels="True">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{TemplateBinding Header}"
                           Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold"
                           FontSize="14" Margin="14,10,14,0"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"/>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- flat button: 1px border, subtle hover, no default 3D chrome -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource Brush.ButtonBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.ButtonText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- toggle that looks like the flat Button; checked = accent fill (used for the
         overlay open/close, always-on-top and lock toggles) -->
    <Style x:Key="OverlayToggle" TargetType="ToggleButton">
      <Setter Property="Background" Value="{DynamicResource Brush.ButtonBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.ButtonText}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ButtonHover}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.SwitchOn}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.SwitchOn}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5,3"/>
    </Style>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <!-- proportional split: both columns scale with the window width -->
      <ColumnDefinition Width="2*" MinWidth="420"/>
      <ColumnDefinition Width="1*" MinWidth="300"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- status -->
      <RowDefinition Height="Auto"/>   <!-- server frames -->
      <RowDefinition Height="*"/>      <!-- console + right column -->
      <RowDefinition Height="Auto"/>   <!-- disclaimer footer -->
    </Grid.RowDefinitions>

    <!-- status bar -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Card}" CornerRadius="8"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Padding="12,8" Margin="0,0,0,10"
            ToolTip="Green = connected to a game server and reading times. Grey = searching for the server (join an ACR lobby).">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Ellipse x:Name="StateDot" Width="11" Height="11" Fill="{DynamicResource Brush.Muted}"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock x:Name="StateText" Text="Starting…" VerticalAlignment="Center"
                     FontSize="14" FontWeight="SemiBold"/>
          <TextBlock x:Name="ServerText" Text="" Foreground="{DynamicResource Brush.Muted}"
                     VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                    ToolTip="Toggle the light / dark theme. Initialised from your Windows setting.">
          <TextBlock x:Name="ThemeLabel" Text="Light mode" Foreground="{DynamicResource Brush.Muted}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <CheckBox x:Name="ThemeToggle" Style="{StaticResource ToggleSwitch}"
                    Checked="ThemeToggle_Changed" Unchecked="ThemeToggle_Changed"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- server frames, side by side -->
    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Local web server" Margin="0,0,6,0"
                ToolTip="Serves the live classification page on this PC (open on the same LAN).">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBox x:Name="PortBox" Grid.Column="1" Text="8080" Width="58" VerticalAlignment="Center"
                   ToolTip="TCP port for the local web server. Change it only if 8080 is already in use."/>
          <Button x:Name="StartWebBtn" Grid.Column="2" Content="Start" Margin="8,0,8,0"
                  Click="StartWebBtn_Click"
                  ToolTip="Start the local web server. The URL can be opened by anyone on the same local network. Click again to stop it."/>
          <TextBox x:Name="LocalUrlBox" Grid.Column="3" IsReadOnly="True" Text="" VerticalAlignment="Center"
                   ToolTip="Local URL (same Wi-Fi / LAN). Click to select, then copy."/>
          <Button x:Name="OpenLocalBtn" Grid.Column="4" Content="↗" Padding="9,3" Margin="6,0,0,0"
                  Click="OpenLocalBtn_Click" FontSize="15"
                  ToolTip="Open this URL in your default browser."/>
        </Grid>
      </GroupBox>

      <GroupBox Grid.Column="1" Header="Publish (Cloudflare Tunnel)" Margin="6,0,0,0"
                ToolTip="Public https:// link so people outside your network can watch. No account, no port forwarding.">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="PublishBtn" Content="Publish" IsEnabled="False" Margin="0,0,8,0"
                  Click="PublishBtn_Click"
                  ToolTip="Start Cloudflare Tunnel and generate a public shareable URL. Start the web server first. Click again to take the link offline."/>
          <TextBox x:Name="PublicUrlBox" Grid.Column="1" IsReadOnly="True" Text="" VerticalAlignment="Center"
                   ToolTip="Public URL to share. Stays valid while this app runs."/>
          <Button x:Name="CopyPublicBtn" Grid.Column="2" Content="⧉" Padding="9,3" Margin="6,0,0,0"
                  Click="CopyPublicBtn_Click" FontSize="15"
                  ToolTip="Copy this link to the clipboard."/>
          <Button x:Name="OpenPublicBtn" Grid.Column="3" Content="↗" Padding="9,3" Margin="6,0,0,0"
                  Click="OpenPublicBtn_Click" FontSize="15"
                  ToolTip="Open this URL in your default browser."/>
        </Grid>
      </GroupBox>
    </Grid>

    <!-- first column: page title/description inputs on top, activity log below -->
    <Grid Grid.Row="2" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <GroupBox Grid.Row="0" Header="Web page title &amp; description"
                ToolTip="Optional heading and blurb shown at the top of the shared web page. Leave empty to hide.">
        <StackPanel>
          <TextBox x:Name="PageTitleBox" Margin="0,0,0,6" MaxLength="120"
                   TextChanged="PageTitleBox_TextChanged"
                   ToolTip="Page title (e.g. the event or championship name). Empty = hidden."/>
          <TextBox x:Name="PageDescBox" AcceptsReturn="True" TextWrapping="Wrap"
                   Height="52" VerticalScrollBarVisibility="Auto"
                   VerticalContentAlignment="Top" MaxLength="600"
                   TextChanged="PageDescBox_TextChanged"
                   ToolTip="Page description shown under the title. Empty = hidden."/>
        </StackPanel>
      </GroupBox>

      <!-- console -->
      <GroupBox Grid.Row="1" Header="Activity log" Margin="0">
        <TextBox x:Name="ConsoleBox" IsReadOnly="True"
                 Background="{DynamicResource Brush.Console}" Foreground="{DynamicResource Brush.Text}"
                 FontFamily="Consolas" FontSize="12" BorderThickness="0"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" VerticalContentAlignment="Top"
                 ToolTip="Live activity: server detection, finishers, connection state."/>
      </GroupBox>
    </Grid>

    <!-- right column: Stages, Config, Debug -->
    <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="12,0,0,0"
                  VerticalScrollBarVisibility="Visible">
      <StackPanel>
        <GroupBox Header="Stages — uncheck to exclude">
          <StackPanel>
            <TextBlock Text="Excluded stages disappear from the page and the total."
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <StackPanel x:Name="StagesPanel">
              <TextBlock Text="(no stage yet)" Foreground="{DynamicResource Brush.Muted}"/>
            </StackPanel>
            <Button x:Name="ResetBtn" Content="Reset session" Margin="0,8,0,0"
                    HorizontalAlignment="Right" Click="ResetBtn_Click"
                    ToolTip="Clear the whole session (all stages and times)."/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Config">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
              <TextBlock Text="Penalty threshold: 1st +" VerticalAlignment="Center"/>
              <TextBox x:Name="PctBox" Text="20" Width="46" Margin="6,0,4,0"
                       TextChanged="PctBox_TextChanged"
                       ToolTip="A driver who misses a stage, or is slower than (fastest + this %), is counted at that threshold time (shown in grey italic on the page)."/>
              <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Missing / too-slow times count as fastest + threshold."
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
              <TextBlock Text="Max progression range:" VerticalAlignment="Center"/>
              <TextBox x:Name="ProgressWindowBox" Text="2.0" Width="46" Margin="6,0,2,0"
                       VerticalAlignment="Center" TextChanged="ProgressWindowBox_TextChanged"
                       ToolTip="Maximum span of the progression bar at the top of the page. The bar auto-fits the field (leader on the right, last running car on the left); this caps how wide it can stretch. Once the field spreads past it, the leader stays right-pinned and cars further back are hidden."/>
              <StackPanel VerticalAlignment="Center">
                <Button Content="▲" Tag="0.1" Click="ProgressWindowStep_Click"
                        Padding="0" FontSize="8" Width="16" Height="12" ToolTip="+0.1 km"/>
                <Button Content="▼" Tag="-0.1" Click="ProgressWindowStep_Click"
                        Padding="0" FontSize="8" Width="16" Height="12" Margin="0,1,0,0" ToolTip="-0.1 km"/>
              </StackPanel>
              <TextBlock Text="km" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="FinishGatingCheck" Content="Hide split times (finish gating)"
                      IsChecked="True" Margin="0,8,0,0"
                      Checked="FinishGating_Changed" Unchecked="FinishGating_Changed"
                      ToolTip="On: reveal a time only once the car has crossed the finish line (RaceStateData timer), hiding intermediate sector splits. Off: show each driver's latest cumulative split as it arrives."/>
            <CheckBox x:Name="HideNationsCheck" Content="Hide nationalities (shared view)"
                      IsChecked="False" Margin="0,8,0,0"
                      Checked="HideNations_Changed" Unchecked="HideNations_Changed"
                      ToolTip="Privacy: when on, driver nationality flags are removed from the shared web page (local and public). Names and times still show. Turn on if you publish the page and would rather not expose other players' nationalities."/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Overlays (OBS / streaming)"
                  ToolTip="Independent, resizable windows showing a single widget on a transparent background. Start the web server first — overlays load from it.">
          <StackPanel>
            <TextBlock Text="Floating windows for capture. Drag by the top bar, resize by the edges. Each is configured independently below."
                       Foreground="{DynamicResource Brush.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Classification column -->
              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                <TextBlock Text="Classification" FontWeight="600" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <ToggleButton x:Name="OverlayTableToggle" Content="Show" IsEnabled="False"
                                Style="{StaticResource OverlayToggle}" Margin="0,0,6,0"
                                Checked="OverlayTableToggle_Checked" Unchecked="OverlayTableToggle_Unchecked"
                                ToolTip="Open / close the general classification overlay."/>
                  <ToggleButton x:Name="TableTopmostToggle" Content="&#xE718;" IsEnabled="False"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Style="{StaticResource OverlayToggle}" Padding="9,6" Margin="0,0,6,0"
                                Checked="TableTopmost_Changed" Unchecked="TableTopmost_Changed"
                                ToolTip="Keep this overlay above other windows (needed over a fullscreen game)."/>
                  <ToggleButton x:Name="TableLockToggle" Content="&#xE72E;" IsEnabled="False"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Style="{StaticResource OverlayToggle}" Padding="9,6"
                                Checked="TableLock_Changed" Unchecked="TableLock_Changed"
                                ToolTip="Click-through: the mouse passes to the game behind. The bar hides while locked; unlock here."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Background:" VerticalAlignment="Center"/>
                  <TextBox x:Name="TableOpacityBox" Text="80" Width="40" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextChanged="TableOpacity_Changed"
                           ToolTip="Overlay background opacity in %, in steps of 10 (100 = solid, 0 = fully transparent)."/>
                  <StackPanel Margin="2,0,0,0">
                    <Button Content="▲" Tag="10" Click="TableOpacityStep_Click"
                            Padding="0" FontSize="8" Width="16" Height="12" ToolTip="+10%"/>
                    <Button Content="▼" Tag="-10" Click="TableOpacityStep_Click"
                            Padding="0" FontSize="8" Width="16" Height="12" Margin="0,1,0,0" ToolTip="-10%"/>
                  </StackPanel>
                </StackPanel>
                <Button x:Name="TableCopyUrlBtn" Content="Copy OBS source URL" IsEnabled="False"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                        Click="CopyTableUrl_Click"
                        ToolTip="Copy the URL for an OBS Browser Source (transparent). In OBS: Sources → + → Browser, paste, then set Width/Height."/>
              </StackPanel>

              <!-- Progress column -->
              <StackPanel Grid.Column="1" Margin="6,0,0,0">
                <TextBlock Text="Progress" FontWeight="600" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <ToggleButton x:Name="OverlayProgressToggle" Content="Show" IsEnabled="False"
                                Style="{StaticResource OverlayToggle}" Margin="0,0,6,0"
                                Checked="OverlayProgressToggle_Checked" Unchecked="OverlayProgressToggle_Unchecked"
                                ToolTip="Open / close the live progression overlay."/>
                  <ToggleButton x:Name="ProgTopmostToggle" Content="&#xE718;" IsEnabled="False"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Style="{StaticResource OverlayToggle}" Padding="9,6" Margin="0,0,6,0"
                                Checked="ProgTopmost_Changed" Unchecked="ProgTopmost_Changed"
                                ToolTip="Keep this overlay above other windows (needed over a fullscreen game)."/>
                  <ToggleButton x:Name="ProgLockToggle" Content="&#xE72E;" IsEnabled="False"
                                FontFamily="Segoe MDL2 Assets" FontSize="14"
                                Style="{StaticResource OverlayToggle}" Padding="9,6"
                                Checked="ProgLock_Changed" Unchecked="ProgLock_Changed"
                                ToolTip="Click-through: the mouse passes to the game behind. The bar hides while locked; unlock here."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Background:" VerticalAlignment="Center"/>
                  <TextBox x:Name="ProgOpacityBox" Text="80" Width="40" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextChanged="ProgOpacity_Changed"
                           ToolTip="Overlay background opacity in %, in steps of 10 (100 = solid, 0 = fully transparent)."/>
                  <StackPanel Margin="2,0,0,0">
                    <Button Content="▲" Tag="10" Click="ProgOpacityStep_Click"
                            Padding="0" FontSize="8" Width="16" Height="12" ToolTip="+10%"/>
                    <Button Content="▼" Tag="-10" Click="ProgOpacityStep_Click"
                            Padding="0" FontSize="8" Width="16" Height="12" Margin="0,1,0,0" ToolTip="-10%"/>
                  </StackPanel>
                </StackPanel>
                <Button x:Name="ProgCopyUrlBtn" Content="Copy OBS source URL" IsEnabled="False"
                        HorizontalAlignment="Left" Margin="0,8,0,0" Padding="8,3"
                        Click="CopyProgUrl_Click"
                        ToolTip="Copy the URL for an OBS Browser Source (transparent). In OBS: Sources → + → Browser, paste, then set Width/Height."/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Debug">
          <StackPanel>
            <CheckBox x:Name="SavePcapCheck" Content="Save .pcap capture"
                      VerticalAlignment="Center"
                      Checked="SavePcap_Checked" Unchecked="SavePcap_Unchecked"
                      ToolTip="Record every captured packet to a .pcap file, openable in Wireshark and replayable in this app. For troubleshooting only."/>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Replay pause (s):" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                <TextBox x:Name="ReplayPauseBox" Text="0" Width="46" VerticalAlignment="Center"
                         ToolTip="Seconds to wait after each classification change while replaying, so the evolution is visible on the page. 0 = replay as fast as possible."/>
                <StackPanel Margin="2,0,0,0">
                  <Button Content="▲" Tag="0.1" Click="ReplayPauseStep_Click"
                          Padding="0" FontSize="8" Width="16" Height="12"
                          ToolTip="+0.1s"/>
                  <Button Content="▼" Tag="-0.1" Click="ReplayPauseStep_Click"
                          Padding="0" FontSize="8" Width="16" Height="12" Margin="0,1,0,0"
                          ToolTip="-0.1s"/>
                </StackPanel>
              </StackPanel>
              <Button x:Name="ReplayBtn" Grid.Column="3" Content="Replay a .pcap…"
                      Click="ReplayBtn_Click"
                      ToolTip="Load a recorded .pcap and replay it through the decoder to rebuild the classification offline (live capture is paused during replay). Click again while running to stop."/>
            </Grid>
            <!-- collapses while empty so it leaves no blank gap at the bottom of Debug -->
            <TextBlock x:Name="PcapStatus" Text="" TextWrapping="Wrap" Margin="0,6,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}"/>
                  <Style.Triggers>
                    <Trigger Property="Text" Value="">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <!-- non-affiliation / trademark disclaimer -->
    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="2,8,2,0"
               Foreground="{DynamicResource Brush.Faint}" FontSize="11" TextWrapping="Wrap"
               Text="Unofficial fan-made tool — not affiliated with or endorsed by Kunos Simulazioni, Supernova Games Studios or 505 Games. &quot;Assetto Corsa&quot; is a trademark of its respective owners, used here only to indicate compatibility. Reads cleartext traffic only; never decrypts."/>
  </Grid>
</Window>
