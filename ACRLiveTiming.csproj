<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ACRLiveTiming</RootNamespace>
    <AssemblyName>ACRLiveTiming</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Multi-size .ico built from assets/icon.svg (+ icon-16.svg simplified variant). -->
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <!-- x64 only: the overlay P/Invokes Get/SetWindowLongPtr, which 32-bit
         user32.dll does not export (they are macros over Get/SetWindowLong). -->
    <PlatformTarget>x64</PlatformTarget>
    <Copyright>Copyright (C) 2026 Florent DESCHAMPS</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <!-- Fallback when the source is outside a Git checkout. Development builds in a
         checkout replace this with the latest version tag below; release builds pass
         -p:Version=x.y.z explicitly. AppInfo then appends the commit sha to identify
         individual prerelease builds. -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Florent DESCHAMPS</Authors>
    <Company>Florent DESCHAMPS</Company>
    <Product>ACR Live Timing</Product>
    <AssemblyTitle>ACR Live Timing</AssemblyTitle>
    <Description>Live shared leaderboard for Assetto Corsa Rally multiplayer lobbies — passive cleartext traffic decoding, embedded web view, optional Cloudflare tunnel.</Description>
    <RepositoryUrl>https://github.com/FlorentDChamps/acr-live-timing</RepositoryUrl>
  </PropertyGroup>

  <!-- Make local/dev builds report the latest release they are based on instead of
       the static fallback above (v1.2.3 becomes 1.2.3-dev). An explicitly supplied
       release Version deliberately bypasses this target. -->
  <Target Name="SetDevelopmentVersionFromGitTag"
          BeforeTargets="GetAssemblyVersion"
          Condition="'$(Version)' == '$(VersionPrefix)-$(VersionSuffix)'">
    <PropertyGroup>
      <_GitSafeDirectory>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))</_GitSafeDirectory>
    </PropertyGroup>
    <Exec Command="git -c safe.directory=$(_GitSafeDirectory) describe --tags --abbrev=0 2&gt;NUL"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_LatestGitTagOutput" />
    </Exec>
    <PropertyGroup Condition="'$(_LatestGitTagOutput)' != ''">
      <_LatestGitTag>$([System.String]::Copy('$(_LatestGitTagOutput)').Trim())</_LatestGitTag>
      <_LatestGitTag>$([System.Text.RegularExpressions.Regex]::Replace('$(_LatestGitTag)', '^v', ''))</_LatestGitTag>
      <Version>$(_LatestGitTag)-$(VersionSuffix)</Version>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- App.xaml lives under src/, so the root-only auto-glob misses it:
         declare it as the entry point and drop it from the Page glob. -->
    <ApplicationDefinition Include="src\App.xaml" />
    <Page Remove="src\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web UI served over HTTP; embedded so it ships inside the exe. -->
    <EmbeddedResource Include="src\Web\index.html" />
    <!-- Generated ACR content labels; raw wire ids stay in the published state. -->
    <EmbeddedResource Include="src\Content\acr-content.json" />
    <!-- Used as a PNG attachment in Discord embeds at runtime. -->
    <Resource Include="assets\icon.ico" />
    <!-- Expose the project property to runtime consumers (Discord embeds, About links). -->
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Streaming overlay windows host the local page in an embedded browser. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
